# AIKOVA Receptionist — copy to .env (never commit .env)
# Rotate keys without redeploy: update VPS .env + `pm2 restart aikova-receptionist-api`
# and `supabase secrets set KEY=...` for Edge Functions (see README).

# --- Supabase (Auth + RLS + Edge + Realtime) ---
EXPO_PUBLIC_SUPABASE_URL=https://heaqcfmphxwfzkqtatrt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=heaqcfmphxwfzkqtatrt
SUPABASE_ACCESS_TOKEN=

# Vite web (same public values)
VITE_SUPABASE_URL=https://heaqcfmphxwfzkqtatrt.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Speech + Brain (required to go green on /readiness voice PASS) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
COQUI_TTS_URL=
QDRANT_URL=
QDRANT_API_KEY=

# --- Africa telephony ---
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=
# aliases also accepted by edge fns:
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_FROM=
FLUTTERWAVE_SECRET=
PAYSTACK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# --- Eurozone / UK telephony + billing ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM=
VONAGE_API_KEY=
STRIPE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_AKC_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# --- App URLs ---
EXPO_PUBLIC_API_BASE_URL=https://ai-receptionist.aikova.co.uk
EXPO_PUBLIC_APP_URL=https://ai-receptionist.aikova.co.uk
VITE_API_BASE_URL=https://ai-receptionist.aikova.co.uk
VITE_APP_URL=https://ai-receptionist.aikova.co.uk

# --- API ---
CRM_API_PORT=3016
CRM_ALLOW_ANON=0
CRM_CORS_ORIGINS=https://ai-receptionist.aikova.co.uk,http://localhost:5173,http://localhost:8081
ADMIN_CLAIM_SECRET=

# --- GitHub ---
GITHUB_OWNER=Beeplus7
GITHUB_REPO=AIKOVA-Receptionist-

# --- VPS (production is nginx + pm2, not Vercel) ---
VPS_HOST=87.106.103.43
VPS_USER=root
VPS_SSH_PORT=22
VPS_DEPLOY_PATH=/var/www/ai-receptionist

# Google OAuth (Supabase Auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
